# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# JWT secret for signing auth tokens (change this to a long random string in production)
JWT_SECRET=your-jwt-secret-here

# JWT expiry
JWT_EXPIRES_IN=7d

# Google Gemini API key (free tier at ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# Port for the backend server
PORT=4000

# Allowed frontend origin(s) for CORS (comma-separated for multiple)
# Set this to the deployed frontend URL(s) in production.
# FRONTEND_URL=https://your-app.vercel.app

# Node environment
NODE_ENV=development

# Max content size in bytes for fetched pages (default 500KB)
MAX_CONTENT_BYTES=512000

# Max pages to crawl per company site
MAX_CRAWL_PAGES=10

# Request timeout in milliseconds
FETCH_TIMEOUT_MS=10000

# Max coverage passes before stopping
MAX_COVERAGE_PASSES=3
